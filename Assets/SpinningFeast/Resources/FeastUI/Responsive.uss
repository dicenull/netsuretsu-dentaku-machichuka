/* One UXML tree, responsive placement. Parent stage supplies portrait class. */
.portrait .screen { font-size:16px; }
.portrait Button { min-height:48px; font-size:16px; padding:3px; }
.portrait TextField { font-size:22px; }
.portrait #title-deco-0 { height:12px; }
.portrait #title-screen #settings-open { right:16px;bottom:12px;width:52px;height:52px; }
.portrait #hud-deco-0 { height:8px; }
.portrait #hud-deco-1 { left:16px;top:34px;width:208px;height:124px; }
.portrait #hud-deco-2 { display:none; }
.portrait #hud-static-0 { left:28px;top:48px;width:70px;height:36px;font-size:16px; }
.portrait #hud-static-2 { left:28px;top:106px;width:70px;height:30px;font-size:16px; }
.portrait #score-0 { left:100px;top:48px;width:112px;height:36px;font-size:23px;-unity-text-align:middle-right; }
.portrait #score-1 { left:100px;top:106px;width:112px;height:30px;font-size:19px;-unity-text-align:middle-right; }
.portrait #timer { left:238px;top:34px;width:106px;height:124px;font-size:34px; }
.portrait #hud-static-1, .portrait #hud-static-3, .portrait #hud-deco-3, .portrait #hud-deco-4 { display:none; }
.portrait #input-dock { left:16px;top:auto;bottom:76px;width:auto;right:16px;height:60px;flex-direction:row; }
.portrait #dish-input { position:relative;left:auto;top:auto;width:auto;height:60px;flex-grow:1;flex-shrink:1;min-width:0; }
.portrait #submit { position:relative;left:auto;top:auto;width:70px;height:60px;margin-left:8px;flex-shrink:0; }
.portrait #bottom-actions { left:16px;right:16px;top:auto;bottom:12px;width:auto;height:52px;flex-direction:row; }
.portrait #book-open { position:relative;left:auto;top:auto;width:auto;height:52px;flex-grow:1; }
.portrait #bottom-actions #settings-open { position:relative;right:auto;bottom:auto;width:52px;height:52px;flex-shrink:0; }
.portrait .settings-paper { width:84%;max-width:344px;padding:18px; }
.portrait #book-open { margin-right:8px; }
.portrait #result-stamp { display:none; }
.portrait #replay { left:16px;top:auto;bottom:12px;width:188px;height:56px; }
.portrait #title { left:216px;top:auto;bottom:12px;width:128px;height:56px; }
.portrait #book-receipt { left:8px;top:8px;width:auto;right:8px;height:auto;bottom:8px; }
.portrait #book-heading { left:20px;top:24px;width:194px;height:40px;font-size:25px; }
.portrait #book-count { left:216px;top:24px;width:124px;height:40px;font-size:15px; }
.portrait #book-scroll { left:18px;right:18px;top:86px;bottom:82px;width:auto;height:auto; }
.portrait .recipe-grid Button { width:48%;height:48px;margin-right:2%;margin-bottom:8px;font-size:15px; }
.portrait #book-prev { left:20px;top:auto;bottom:20px;width:65px;height:52px; }
.portrait #book-page { left:88px;top:auto;bottom:20px;width:82px;height:52px;font-size:16px; }
.portrait #book-next { left:173px;top:auto;bottom:20px;width:65px;height:52px; }
.portrait #book-close { left:242px;top:auto;bottom:20px;width:98px;height:52px; }
.portrait #title-deco-1, .portrait #noren-0 { left:16px;top:22px;width:44px;height:96px; }
.portrait #noren-0 { font-size:36px; }
.portrait #title-deco-2, .portrait #noren-1 { left:63px;top:22px;width:44px;height:96px; }
.portrait #noren-1 { font-size:36px; }
.portrait #title-deco-3, .portrait #noren-2 { left:110px;top:22px;width:44px;height:96px; }
.portrait #noren-2 { font-size:36px; }
.portrait #title-deco-4, .portrait #noren-3 { left:157px;top:22px;width:44px;height:96px; }
.portrait #noren-3 { font-size:36px; }
.portrait #title-deco-5, .portrait #noren-4 { left:204px;top:22px;width:44px;height:96px; }
.portrait #noren-4 { font-size:36px; }
.portrait #title-deco-6, .portrait #noren-5 { left:251px;top:22px;width:44px;height:96px; }
.portrait #noren-5 { font-size:36px; }
.portrait #title-deco-7, .portrait #noren-6 { left:298px;top:22px;width:44px;height:96px; }
.portrait #noren-6 { font-size:36px; }
.portrait #hud-dish-0-0 { display:none; }
.portrait #hud-dish-0-1 { display:none; }
.portrait #hud-dish-0-2 { display:none; }
.portrait #hud-dish-1-0 { display:none; }
.portrait #hud-dish-1-1 { display:none; }
.portrait #hud-dish-1-2 { display:none; }

/* Decoration shares the same proportional portrait and min-height stage. */
.portrait .table-serial { left:27px;top:39px;width:175px;height:13px;font-size:9px; }
.portrait #hud-deco-3 { display:flex;left:28px;top:90px;width:180px;height:8px; }
.portrait #timer { height:72px;top:53px; }
.portrait #input-dock { flex-direction:row;align-items:center;padding-left:4px;padding-right:4px; }
.portrait #dish-input, .portrait #submit { height:50px; }
.portrait .book-perf { left:20px;top:72px;width:320px;height:8px; }
.portrait .ordered-stamp { left:auto;right:19px;top:123px;width:104px;height:38px;font-size:22px;border-width:3px; }

.portrait .deadline-call { left:17px;right:17px;top:170px;width:auto;height:34px;font-size:18px; }

.portrait .checkout-tabs { left:16px;right:16px;top:12px;height:51px; }
.portrait .checkout-tab { height:50px;font-size:20px; }
.portrait .checkout-scroll { left:16px;right:16px;top:72px;bottom:81px; }
.portrait .paper-contents { padding:7px 17px 17px; }
.portrait .paper-tear { height:7px; }
.portrait .checkout-serial { font-size:10px;min-height:19px; }
.portrait .checkout-heading { font-size:27px;min-height:39px; }
.portrait .checkout-outcome { font-size:17px;min-height:34px; }
.portrait .checkout-scoreline { min-height:54px;font-size:18px; }
.portrait .checkout-score { font-size:30px; }
.portrait .checkout-subheading { min-height:29px;font-size:15px; }
.portrait .checkout-row { min-height:36px; }
.portrait .checkout-dish { font-size:16px; }
.portrait .checkout-count { font-size:14px; }
.portrait .checkout-empty { font-size:15px; }
.portrait .checkout-total { min-height:43px;font-size:20px; }
.portrait .checkout-barcode { width:145px;height:22px;margin-top:14px; }

.portrait .title-order-sheet { left:16px;top:22%;width:328px;padding:12px 13px 16px; }
.portrait .order-serial { right:10px;top:5px;font-size:10px; }
.portrait .title-order-heading { min-height:51px;font-size:27px; }
.portrait .title-order-rule { height:8px;margin-bottom:9px; }
.portrait .title-order-difficulty { min-height:28px;font-size:16px; }
.portrait .title-order-options { margin-top:6px;margin-bottom:13px; }
.portrait .title-order-choice { min-height:49px;font-size:16px; }
.portrait .title-order-start { min-height:57px;font-size:22px; }

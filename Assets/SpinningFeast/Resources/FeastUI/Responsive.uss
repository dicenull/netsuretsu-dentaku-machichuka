/* One UXML tree, responsive placement. Parent stage supplies portrait class. */
.portrait .screen { font-size:16px; }
.portrait Button { min-height:48px; font-size:16px; padding:3px; }
.portrait TextField { font-size:22px; }
.portrait #title-deco-0 { height:12px; }
.portrait #title-hero { left:22px;top:146px;width:316px;height:154px;font-size:42px; }
.portrait #title-tagline { left:22px;top:316px;width:316px;height:60px;font-size:20px; }
.portrait #title-deco-8 { left:16px;top:420px;width:328px;height:270px; }
.portrait #title-deco-9 { left:30px;top:478px;width:300px;height:2px; }
.portrait #order-heading { left:30px;top:434px;width:300px;height:40px;font-size:24px; }
.portrait #cpu-heading { left:30px;top:490px;width:300px;height:28px;font-size:16px; }
.portrait #start { left:30px;top:590px;width:300px;height:60px; }
.portrait #start-hint { display:none; }
.portrait #cpu-description { left:30px;top:655px;width:300px;height:30px;font-size:13px; }
.portrait #title-screen #music { left:100px;top:auto;bottom:12px;width:160px;height:52px; }
.portrait #hud-deco-0 { height:8px; }
.portrait #hud-deco-1 { left:16px;top:34px;width:208px;height:124px; }
.portrait #hud-deco-2 { display:none; }
.portrait #hud-static-0 { left:28px;top:48px;width:70px;height:36px;font-size:16px; }
.portrait #hud-static-2 { left:28px;top:106px;width:70px;height:30px;font-size:16px; }
.portrait #score-0 { left:100px;top:48px;width:112px;height:36px;font-size:23px;-unity-text-align:middle-right; }
.portrait #score-1 { left:100px;top:106px;width:112px;height:30px;font-size:19px;-unity-text-align:middle-right; }
.portrait #timer { left:238px;top:34px;width:106px;height:124px;font-size:34px; }
.portrait #hud-static-1, .portrait #hud-static-3, .portrait #hud-deco-3, .portrait #hud-deco-4 { display:none; }
.portrait #input-dock { left:16px;top:auto;bottom:76px;width:auto;right:16px;height:60px;flex-direction:row; }
.portrait #dish-input { position:relative;left:auto;top:auto;width:auto;height:60px;flex-grow:1;flex-shrink:1;min-width:0; }
.portrait #submit { position:relative;left:auto;top:auto;width:70px;height:60px;margin-left:8px;flex-shrink:0; }
.portrait #bottom-actions { left:16px;right:16px;top:auto;bottom:12px;width:auto;height:52px;flex-direction:row; }
.portrait #book-open, .portrait #bottom-actions #music { position:relative;left:auto;top:auto;width:auto;height:52px;flex-grow:1; }
.portrait #book-open { margin-right:8px; }
.portrait.keyboard-open #bottom-actions { display:none; }
.portrait.keyboard-open #input-dock { bottom:8px; }
.portrait #result-receipt { left:24px;top:12px;width:auto;right:24px;height:auto;bottom:130px; }
.portrait #receipt-heading { left:40px;top:28px;width:280px;height:40px;font-size:25px; }
.portrait #result-heading { left:40px;top:78px;width:280px;height:44px;font-size:22px; }
.portrait #result-stamp { display:none; }
.portrait #result-scroll { left:42px;top:134px;width:auto;right:42px;height:auto;bottom:228px; }
.portrait #result-content { min-height:640px; }

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <Style src="Shared.uss" />
  <Style src="Responsive.uss" />
  <ui:VisualElement name="title-screen" class="screen title-screen" picking-mode="Ignore">
    <ui:VisualElement class="title-masthead" name="title-masthead" picking-mode="Ignore">
      <ui:VisualElement class="store-rail fill-secondary title-node-1" picking-mode="Ignore" name="title-deco-0" />
      <ui:VisualElement class="noren-print fill-accent title-node-2" picking-mode="Ignore" name="title-deco-1" />
      <ui:Label class="menu-display noren-letter center bold light title-node-3" text="熱" picking-mode="Ignore" name="noren-0" />
      <ui:VisualElement class="noren-print fill-accent title-node-4" picking-mode="Ignore" name="title-deco-2" />
      <ui:Label class="menu-display noren-letter center bold light title-node-5" text="烈" picking-mode="Ignore" name="noren-1" />
      <ui:VisualElement class="noren-print fill-accent title-node-6" picking-mode="Ignore" name="title-deco-3" />
      <ui:Label class="menu-display noren-letter center bold light title-node-7" text="電" picking-mode="Ignore" name="noren-2" />
      <ui:VisualElement class="noren-print fill-accent title-node-8" picking-mode="Ignore" name="title-deco-4" />
      <ui:Label class="menu-display noren-letter center bold light title-node-9" text="卓" picking-mode="Ignore" name="noren-3" />
      <ui:VisualElement class="noren-print fill-accent title-node-10" picking-mode="Ignore" name="title-deco-5" />
      <ui:Label class="menu-display noren-letter center bold light title-node-11" text="町" picking-mode="Ignore" name="noren-4" />
      <ui:VisualElement class="noren-print fill-accent title-node-12" picking-mode="Ignore" name="title-deco-6" />
      <ui:Label class="menu-display noren-letter center bold light title-node-13" text="中" picking-mode="Ignore" name="noren-5" />
      <ui:VisualElement class="noren-print fill-accent title-node-14" picking-mode="Ignore" name="title-deco-7" />
      <ui:Label class="menu-display noren-letter center bold light title-node-15" text="華" picking-mode="Ignore" name="noren-6" />
    </ui:VisualElement>
    <ui:VisualElement class="order-paper receipt title-order-sheet" name="title-order-sheet" picking-mode="Ignore">
      <ui:Label class="printed-key order-serial" text="N° 01" picking-mode="Ignore" />
      <ui:Label class="menu-display center title-order-heading" text="ご注文票" picking-mode="Ignore" name="order-heading" />
      <ui:VisualElement class="ticket-perf title-order-rule" picking-mode="Ignore" />
      <ui:Label class="printed-key center title-order-difficulty" text="相手の強さ" picking-mode="Ignore" name="cpu-heading" />
      <ui:VisualElement class="title-order-options" picking-mode="Ignore">
        <ui:Button class="title-order-choice padded-choice" name="cpu-0" />
        <ui:Button class="title-order-choice padded-choice" name="cpu-1" />
        <ui:Button class="title-order-choice" name="cpu-2" />
      </ui:VisualElement>
      <ui:Button class="menu-display stamped-action primary title-order-start" name="start" text="いただきます！" />
    </ui:VisualElement>
    <ui:Button class="settings-gear" name="settings-open" tooltip="設定" />
    <ui:VisualElement name="settings-panel" class="settings-overlay">
      <ui:VisualElement name="settings-dismiss" class="settings-dismiss" />
      <ui:VisualElement class="settings-paper">
        <ui:Label class="printed-key settings-kicker" text="町中華 ｜ 店内設定" picking-mode="Ignore" />
        <ui:Label class="menu-display settings-heading" text="設定" picking-mode="Ignore" />
        <ui:VisualElement class="ticket-perf settings-rule" picking-mode="Ignore" />
        <ui:Button name="settings-audio" class="settings-row" text="音：オン" />
        <ui:Button name="settings-close" class="settings-close" text="閉じる" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>

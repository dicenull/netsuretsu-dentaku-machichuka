/* Receipt design. Runtime state is bound by FeastApp, not sample text. */
.screen { position:relative; width:100%; height:100%; --paper:rgb(224,204,169); --surface:rgb(255,250,229); --ink:rgb(62,37,28); --accent:rgb(150,40,28); --secondary:rgb(38,74,58); --muted:rgb(202,177,136); color:var(--ink); -unity-font:url("project://database/Assets/SpinningFeast/Resources/NotoSansJP-Regular.otf"); font-size:20px; }
.title-screen, .result-screen { background-color:var(--paper); }
.hud-screen { background-color:rgba(0,0,0,0); }
Label { margin:0; padding:0; white-space:normal; -unity-text-align:middle-left; }
Button { margin:0; padding:4px; background-color:var(--surface); color:var(--ink); border-width:2px; border-color:var(--ink); border-radius:0; font-size:23px; -unity-font-style:bold; }
Button:hover { background-color:var(--muted); }
Button:focus { border-color:var(--accent); border-width:3px; }
Button:disabled { opacity:0.62; }
.primary { background-color:var(--accent); color:var(--surface); }
.selected { background-color:var(--secondary); color:var(--surface); }
.center { -unity-text-align:middle-center; } .right { -unity-text-align:middle-right; } .bold { -unity-font-style:bold; } .accent { color:var(--accent); } .secondary { color:var(--secondary); }
.paper { background-color:var(--surface); } .muted { background-color:var(--muted); } .fill-accent { background-color:var(--accent); } .fill-secondary { background-color:var(--secondary); } .light { color:var(--surface); }
.receipt { border-top-width:8px; border-top-color:var(--accent); background-color:var(--surface); }
.stamp { border-width:5px; border-color:var(--accent); color:var(--accent); -unity-font-style:bold; -unity-text-align:middle-center; }
TextField { margin:0; padding:0; font-size:25px; color:var(--ink); }
TextField > .unity-text-field__input { background-color:var(--surface); color:var(--ink); border-width:0; border-radius:0; padding-left:12px; padding-right:12px; }
.book-screen { background-color:rgba(31,24,17,0.55); }
.recipe { font-size:18px; white-space:normal; }
.dish-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

.recipe-grid { flex-direction:row;flex-wrap:wrap; }
.recipe-grid Button { width:23.5%;height:68px;margin-right:1.5%;margin-bottom:16px; }
.title-node-1 { position:absolute;left:0px;top:0px;width:1280px;height:24px; }
.title-node-2 { position:absolute;left:54px;top:40px;width:160px;height:190px; }

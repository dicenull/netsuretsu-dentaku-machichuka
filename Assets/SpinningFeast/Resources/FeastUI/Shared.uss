.book-node-29 { position:absolute;left:920px;top:659px;width:110px;height:54px; }.urgent { background-color:var(--accent); color:var(--surface); }

/* Machi-chuka storefront and paper system. Decoration never takes input. */
.title-screen, .result-screen {
    background-color: rgb(238, 217, 169);
    background-image: url("CounterTile.png");
    background-size: 100% 100%;
}
.screen { --ink:rgb(61,38,26); --accent:rgb(158,41,27); --secondary:rgb(40,70,51); --surface:rgb(255,247,216); --muted:rgb(226,187,126); }
.menu-display { -unity-font: url("ReggaeOne-Regular.ttf"); -unity-font-style: normal; }
.store-rail { background-color:rgb(37,58,38); border-bottom-width:3px; border-bottom-color:rgb(184,117,47); }
.noren-print { background-color:rgb(138,32,26); background-image:url("NorenPrint.png"); background-size:100% 100%; border-bottom-width:6px; border-bottom-color:rgb(94,24,23); }
.noren-letter { color:rgb(255,239,194); }
.order-paper {
    background-color:rgb(255,238,195);border-width:2px;border-color:rgb(135,73,40);border-top-width:7px;border-top-color:rgb(160,46,28);border-radius:4px;
}
.rival-ticket { background-color:rgb(242,237,203);border-top-color:rgb(50,90,61); }
.printed-key { color:rgb(100,60,35); -unity-font-style:bold; }
.ticket-perf { background-color:rgba(0,0,0,0);background-image:url("TicketPerf.png");background-size:100% 100%; }
.table-perf { height:8px; }
.book-perf { position:absolute;left:246px;top:156px;width:784px;height:8px; }
.table-serial { position:absolute;left:63px;top:78px;width:180px;height:18px;font-size:12px;-unity-text-align:middle-left; }
.order-line { background-color:rgba(255,255,255,0.25);border-bottom-width:1px;border-bottom-color:rgba(142,83,49,0.34); }
.timer-stamp { background-color:rgb(247,227,174);border-width:3px;border-color:rgb(137,54,35);border-radius:5px;color:rgb(125,36,25); }
.timer-stamp.urgent { background-color:rgb(147,34,23);color:rgb(255,249,222); }
.order-dock { background-color:rgb(236,199,130);border-width:2px;border-color:rgb(115,55,28);border-radius:4px; }
#dish-input > .unity-text-field__input { border-width:1px;border-radius:3px;border-color:rgb(126,75,42);background-color:rgb(255,249,226); }
#dish-input:focus > .unity-text-field__input, #dish-input > .unity-text-field__input:focus { border-color:var(--accent);border-width:2px; }
.stamped-action { border-width:3px;border-color:rgb(112,32,21);border-radius:3px; }
.stamped-action:hover { background-color:rgb(120,34,21);color:rgb(255,249,225); }
.stamped-action:focus { border-color:rgb(46,35,25); }
.secondary-action { border-width:2px;border-radius:3px; }
.menu-item { background-color:rgb(255,246,219);border-width:1px;border-left-width:4px;border-color:rgb(160,105,61); }
.menu-item:hover { background-color:rgb(246,220,163); }
.menu-item:disabled { background-color:rgb(240,226,194); }
.verdict-stamp { rotate:-9deg;border-width:6px;border-radius:13px;background-color:rgba(255,237,187,0.5); }
/* Turn-based feedback: only the decoration moves, never the controls or the IME. */
.ordered-stamp {
    display:none;position:absolute;left:795px;top:574px;width:138px;height:62px;
    border-width:4px;border-color:rgb(156,41,27);border-radius:7px;color:rgb(143,34,23);
    background-color:rgb(255,229,167);font-size:31px;-unity-text-align:middle-center;rotate:-8deg;
}
.cashier-feed { position:absolute;left:0;right:0;top:0;bottom:0; }
.stamped-action:enabled:active { background-color:rgb(104,29,20); }

.deadline-call {
    display:none;position:absolute;left:432px;top:123px;width:416px;height:46px;
    border-width:2px;border-color:rgb(155,55,30);border-radius:4px;
    color:rgb(135,38,26);background-color:rgb(255,237,188);
    font-size:24px;-unity-text-align:middle-center;
}
.deadline-call.last-call { background-color:rgb(155,42,27);color:rgb(255,245,205); }

/* Counter settings: fitting the same printed ticket family without blocking the board when closed. */
.settings-gear { position:absolute;right:38px;bottom:0;width:58px;height:58px;padding:0;align-items:center;justify-content:center;border-radius:3px; }
.title-screen > .settings-gear { right:50px;bottom:20px; }
.settings-icon { width:30px;height:30px; }
.settings-overlay { display:none;position:absolute;left:0;top:0;right:0;bottom:0;align-items:center;justify-content:center; }
.settings-dismiss { position:absolute;left:0;top:0;right:0;bottom:0;background-color:rgba(31,19,14,0.64); }
.settings-paper { width:344px;padding:22px;background-color:var(--surface);border-width:3px;border-color:var(--ink); }
.settings-kicker { color:var(--secondary);font-size:13px; }
.settings-heading { color:var(--accent);font-size:34px;margin-top:3px; }
.settings-rule { height:2px;background-color:var(--muted);margin-top:8px;margin-bottom:14px; }
.settings-row { height:56px;color:var(--secondary);-unity-text-align:middle-left;padding-left:14px; }
.settings-close { height:48px;margin-top:10px; }

/* A player's entire paper feeds through one viewport. Tabs/actions are fixed outside. */
.checkout-tabs { position:absolute;left:350px;right:350px;top:24px;height:60px;flex-direction:row; }
.checkout-tab { flex-grow:1;flex-basis:0;height:58px;font-size:27px;border-bottom-width:4px;border-radius:4px; }
.checkout-tab.selected:hover { background-color:rgb(49,87,62); color:var(--surface); }
.checkout-tab-first { margin-right:8px; }
.checkout-scroll { position:absolute;left:350px;right:350px;top:95px;bottom:23px; }
.checkout-scroll:focus { border-width:1px;border-color:rgba(169,75,48,0.48); }
.checkout-paper { flex-direction:column; }
.paper-contents { background-color:rgb(255,249,228);padding:12px 34px 22px; }
.paper-tear { height:9px;background-image:url("CashierTear.png");background-size:100% 100%; }
.paper-tear-top { rotate:180deg; }
.checkout-serial { font-size:13px;min-height:22px; }
.checkout-heading { font-size:38px;min-height:52px; }
.checkout-outcome { border-top-width:1px;border-bottom-width:1px;border-color:rgb(180,155,113);min-height:43px;font-size:22px; }
.checkout-scoreline { flex-direction:row;justify-content:space-between;align-items:center;min-height:65px;font-size:23px; }
.checkout-score { font-size:36px; }
.checkout-subheading { font-size:17px;min-height:32px;border-bottom-width:2px;border-color:rgb(140,106,69); }
.checkout-dishes { flex-direction:column; }
.checkout-row { flex-direction:row;min-height:39px;align-items:center;border-bottom-width:1px;border-bottom-color:rgba(141,101,65,0.28); }
.checkout-dish { flex-grow:1;flex-shrink:1;flex-basis:0;min-width:0;white-space:normal;padding-right:10px;font-size:19px; }
.checkout-count { flex-shrink:0;white-space:nowrap;font-size:17px; }
.checkout-empty { min-height:48px;font-size:18px; }
.checkout-total { min-height:53px;margin-top:16px;border-top-width:3px;border-bottom-width:1px;border-color:rgb(110,70,42);font-size:25px; }
.checkout-barcode { align-self:center;margin-top:20px;width:185px;height:27px;background-image:url("CashierBarcode.png");background-size:100% 100%; }

/* Title: masthead, one order slip, and the fixed settings gear. */
.title-masthead { position:absolute;left:0;right:0;top:0;bottom:0; }
.title-order-sheet { position:absolute;left:425px;top:267px;width:430px;padding:18px 25px 24px; }
.order-serial { position:absolute;right:12px;top:7px;font-size:13px; }
.title-order-heading { min-height:65px;font-size:38px; }
.title-order-rule { height:10px;margin-bottom:13px; }
.title-order-difficulty { min-height:31px;font-size:20px; }
.title-order-options { flex-direction:row;margin-top:9px;margin-bottom:18px; }
.title-order-choice { flex-grow:1;flex-basis:0;min-height:53px;font-size:20px;white-space:nowrap; }
.padded-choice { margin-right:9px; }
.title-order-choice.selected:hover { background-color:rgb(49,87,62);color:var(--surface); }
.title-order-start { min-height:67px;font-size:26px; }

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <Style src="Shared.uss" />
  <Style src="Responsive.uss" />
  <ui:VisualElement name="result-screen" class="screen result-screen" picking-mode="Ignore">
    <ui:VisualElement class="checkout-tabs" picking-mode="Ignore">
      <ui:Button name="checkout-tab-0" class="menu-display checkout-tab checkout-tab-first selected" text="自分" />
      <ui:Button name="checkout-tab-1" class="menu-display checkout-tab" text="相手" />
    </ui:VisualElement>
    <ui:VisualElement name="cashier-feed" class="cashier-feed" picking-mode="Ignore" usage-hints="DynamicTransform">
      <ui:ScrollView name="checkout-scroll-0" class="checkout-scroll" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" />
      <ui:ScrollView name="checkout-scroll-1" class="checkout-scroll" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" />
    </ui:VisualElement>
    <ui:Label class="menu-display verdict-stamp stamp result-node-40" name="result-stamp" text="" picking-mode="Ignore" />
    <ui:Button class="menu-display stamped-action primary result-node-41" name="replay" text="もう一戦！" />
    <ui:Button class="secondary-action result-node-42" name="title" text="タイトルへ" />
  </ui:VisualElement>
</ui:UXML>

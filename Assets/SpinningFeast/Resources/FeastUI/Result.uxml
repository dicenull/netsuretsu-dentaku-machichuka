<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <Style src="Shared.uss" />
  <Style src="Responsive.uss" />
  <ui:VisualElement name="result-screen" class="screen result-screen" picking-mode="Ignore">
    <ui:VisualElement class="receipt result-node-1" picking-mode="Ignore" name="result-receipt" />

        <ui:Label class="secondary result-node-8" name="result-header-0" text="" picking-mode="Ignore" />
        <ui:Label class="dish-name result-node-9" name="result-name-0-0" text="" picking-mode="Ignore" />
        <ui:Label class="right result-node-10" name="result-count-0-0" text="" picking-mode="Ignore" />
        <ui:Label class="dish-name result-node-11" name="result-name-0-1" text="" picking-mode="Ignore" />
        <ui:Label class="right result-node-12" name="result-count-0-1" text="" picking-mode="Ignore" />
        <ui:Label class="dish-name result-node-13" name="result-name-0-2" text="" picking-mode="Ignore" />
        <ui:Label class="right result-node-14" name="result-count-0-2" text="" picking-mode="Ignore" />
        <ui:Label class="dish-name result-node-15" name="result-name-0-3" text="" picking-mode="Ignore" />
        <ui:Label class="right result-node-16" name="result-count-0-3" text="" picking-mode="Ignore" />
        <ui:Label class="dish-name result-node-17" name="result-name-0-4" text="" picking-mode="Ignore" />
        <ui:Label class="right result-node-18" name="result-count-0-4" text="" picking-mode="Ignore" />
        <ui:Label class="dish-name result-node-19" name="result-name-0-5" text="" picking-mode="Ignore" />
        <ui:Label class="right result-node-20" name="result-count-0-5" text="" picking-mode="Ignore" />
        <ui:Label class="result-node-21" name="result-player-1" text="CPU" picking-mode="Ignore" />
        <ui:Label class="bold accent result-node-22" name="result-score-1" text="" picking-mode="Ignore" />
        <ui:Label class="secondary result-node-23" name="result-header-1" text="" picking-mode="Ignore" />
        <ui:Label class="dish-name result-node-24" name="result-name-1-0" text="" picking-mode="Ignore" />
        <ui:Label class="right result-node-25" name="result-count-1-0" text="" picking-mode="Ignore" />
        <ui:Label class="dish-name result-node-26" name="result-name-1-1" text="" picking-mode="Ignore" />
        <ui:Label class="right result-node-27" name="result-count-1-1" text="" picking-mode="Ignore" />
        <ui:Label class="dish-name result-node-28" name="result-name-1-2" text="" picking-mode="Ignore" />
        <ui:Label class="right result-node-29" name="result-count-1-2" text="" picking-mode="Ignore" />
        <ui:Label class="dish-name result-node-30" name="result-name-1-3" text="" picking-mode="Ignore" />
        <ui:Label class="right result-node-31" name="result-count-1-3" text="" picking-mode="Ignore" />
        <ui:Label class="dish-name result-node-32" name="result-name-1-4" text="" picking-mode="Ignore" />
        <ui:Label class="right result-node-33" name="result-count-1-4" text="" picking-mode="Ignore" />
        <ui:Label class="dish-name result-node-34" name="result-name-1-5" text="" picking-mode="Ignore" />
